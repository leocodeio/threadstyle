# OpenCode Go — Console → Account → Personal API keys.
# Copy this file to .env.local and paste the key. Never commit .env.local.
OPENCODE_API_KEY=

# Optional. Defaults to the Go gateway.
# Pay-as-you-go instead of Go: https://opencode.ai/inference/openai/v1
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
